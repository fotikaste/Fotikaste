// Cloudflare-Konfiguration (ohne Geheimnisse).
// Öffentliche Seiten = statische Assets (gratis, zählen nicht als Worker-Aufruf).
// Nur /api/* und /admin laufen durch den Worker (run_worker_first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fotikaste",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/f/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fotikaste",
      // Cloudflare D1 «fotikaste» (Westeuropa), angelegt 2026-11-26. Kein Geheimnis.
      "database_id": "ab0b1235-e7c5-46d8-916b-4701208ba83b",
      "migrations_dir": "migrations"
    }
  ],
  // Privater Fotospeicher (Phase 5). Ohne öffentliche Adresse, ohne r2.dev. Lokal simuliert wrangler den Bucket;
  // angelegt wird er erst in Phase 7 (EU-Jurisdiktion).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "fotikaste-fotos", "jurisdiction": "eu" }],
  // Täglich 03:15 UTC: abgelaufene Galerien löschen, alte Zähler aufräumen, wartende Mails senden (Cron-Trigger sind gratis).
  "triggers": { "crons": ["15 3 * * *"] },
  "vars": {
    // Lokal überschrieben durch .dev.vars (ENVIRONMENT=development). In Produktion nie «development».
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Keine alternativen Adressen (*.workers.dev, Vorschau-URLs), die Cloudflare Access umgehen könnten.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
