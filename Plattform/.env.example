# Fotikaste-Plattform – Beispiel-Umgebungsvariablen (KEINE echten Werte eintragen!)
# Lokal: nach .dev.vars kopieren (nicht in Git) und ausfüllen.

# Allgemein
PUBLIC_SITE_URL=http://localhost:4321
APP_TIMEZONE=Europe/Zurich

# Lokale Entwicklung: Werte in .dev.vars (nicht in Git). Produktion: `wrangler secret put NAME`.
# D1 und R2 werden als Bindings in wrangler.jsonc verbunden (keine Schlüssel nötig).

# Cloudflare Access (Admin)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Turnstile
TURNSTILE_SITE_KEY=
# Beim Build für das Widget auf /buchen und /konto (öffentlich, kein Geheimnis)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 – nur für vorsignierte Upload-URLs (S3-API), Bucket selbst über Binding
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_JURISDICTION=eu

# E-Mail (Resend)
RESEND_API_KEY=
MAIL_FROM="Fotikaste <noreply@example.invalid>"
# Testmodus: alle Mails gehen nur an diese Adresse
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=

# Sicherheit
DEVICE_TOKEN_PEPPER=
CRON_SECRET=
