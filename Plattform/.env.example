# Fotikaste-Plattform – Beispiel-Umgebungsvariablen (KEINE echten Werte eintragen!)
# Kopieren nach .env.local (wird nicht in Git gespeichert) und dort ausfüllen.

# Allgemein
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Europe/Zurich

# Supabase (Datenbank + Anmeldung)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur auf dem Server verwenden, niemals im Browser:
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (privater Fotospeicher der Plattform)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_JURISDICTION=eu

# E-Mail (Resend)
RESEND_API_KEY=
MAIL_FROM="Fotikaste <noreply@example.invalid>"
# Testmodus: alle Mails gehen nur an diese Adresse
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=

# Sicherheit
DEVICE_TOKEN_PEPPER=
CRON_SECRET=
