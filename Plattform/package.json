{
  "name": "fotikaste-plattform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p worker && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "node tools/lighthouse.mjs",
    "check:worker": "tsc -p worker",
    "db:lokal": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --command \"INSERT OR IGNORE INTO admin_users (email, role) VALUES ('inhaber@example.ch', 'owner')\"",
    "dev:worker": "npm run db:lokal && wrangler dev --port 8788 --ip 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "lighthouse": "13.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
