---
/** Einheitliche Unterseite: Kopfbereich mit Breadcrumb + Inhalt. Titel/Indexierung kommen aus dem Seitenregister. */
import BaseLayout from "./BaseLayout.astro";
import { pageByPath } from "../config/pages";
interface Props { path: string; eyebrow?: string; heading?: string; lead?: string; description?: string; jsonLd?: Record<string, unknown>[]; }
const { path, eyebrow, heading, lead, description, jsonLd } = Astro.props;
const page = pageByPath(path);
---
<BaseLayout title={page.title} path={path} indexable={page.indexable} description={description} jsonLd={jsonLd} privat={page.private} breadcrumbs={[{ name: page.title, path }]}>
  <section class="bg-paper border-b border-line">
    <div class="container-page py-12 sm:py-16">
      <nav aria-label="Brotkrümelnavigation" class="text-sm text-muted"><a href="/" class="hover:text-charcoal">Startseite</a> <span aria-hidden="true">/</span> <span aria-current="page">{page.title}</span></nav>
      {eyebrow && <p class="eyebrow mt-8">{eyebrow}</p>}
      <h1 class="text-[2.6rem] sm:text-6xl mt-4 max-w-[20ch]">{heading ?? page.title}</h1>
      {lead && <p class="mt-5 text-lg text-muted max-w-[60ch]">{lead}</p>}
    </div>
  </section>
  <div class="container-page py-14 sm:py-20"><slot /></div>
</BaseLayout>
