---
/** Zwei Postkarten 10×15 als Platzhalter für echte Abzüge (keine Stockfotos). */
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={["relative mx-auto w-full", compact ? "max-w-xs h-72" : "max-w-[17rem] h-60 sm:max-w-md sm:h-[22rem] lg:h-[27rem]"]} aria-hidden="true">
  <figure class="absolute left-[4%] top-8 w-[58%] aspect-[2/3] bg-white p-3 pb-12 shadow-[0_22px_45px_-28px_rgba(40,30,10,.5)] -rotate-6 m-0">
    <div class="h-full bg-sand-light"></div>
    <figcaption class="absolute bottom-3 inset-x-0 text-center font-display italic text-gold-text">Anna &amp; Luca · Beispiel</figcaption>
  </figure>
  <figure class="absolute right-[4%] top-0 w-[58%] aspect-[2/3] bg-white p-3 pb-12 shadow-[0_26px_50px_-26px_rgba(40,30,10,.55)] rotate-3 m-0">
    <div class="h-full bg-sand flex flex-col items-center justify-center gap-3 text-[#4A3E2B]">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="11" y="3" width="18" height="34"/><rect x="14.5" y="7" width="11" height="8"/><circle cx="20" cy="22" r="2.6"/></svg>
      <span class="text-[0.65rem] tracking-[0.18em] uppercase font-semibold text-center px-4">Platzhalter · echter Abzug folgt</span>
    </div>
    <figcaption class="absolute bottom-3 inset-x-0 text-center font-display italic text-gold-text">Sommerfest · Beispiel</figcaption>
  </figure>
</div>
