---
import { packages } from "../data/content";
interface Props { level?: 2 | 3; }
const { level = 3 } = Astro.props;
const H = level === 2 ? "h2" : "h3";
const chf = (n: number) => new Intl.NumberFormat("de-CH", { style: "currency", currency: "CHF" }).format(n);
---
<div class="grid gap-6 md:grid-cols-3">
  {packages.map((p) => (
    <article class:list={["relative bg-[#FFFDF9] border p-7 flex flex-col", p.slug === "premium" ? "border-gold" : "border-line"]}>
      <div class="absolute top-5 right-5 w-[4.5rem] h-[5.25rem] border border-dashed border-gold flex flex-col items-center justify-center text-gold-text" title="Anzahl Abzüge">
        <span class="font-display text-[1.7rem] leading-none">{p.prints ?? "–"}</span>
        <span class="text-[0.55rem] tracking-[0.16em] uppercase font-semibold mt-1">Abzüge</span>
      </div>
      <H class="text-[1.9rem] pr-20">{p.name}</H>
      <p class="font-semibold mt-1">{p.priceChf === null ? "Preis folgt" : chf(p.priceChf)}</p>
      {p.printsIsExample && <p class="text-xs text-muted mt-1">300 Abzüge als Beispielwert</p>}
      <ul class="mt-5 pt-5 border-t border-line flex flex-col gap-2 text-[0.95rem] text-muted flex-1">
        {p.features.map((f) => <li class="flex gap-2"><span class="text-gold" aria-hidden="true">—</span>{f}</li>)}
      </ul>
      <a href="/verfuegbarkeit" class="mt-6 self-start font-semibold link-underline">Datum prüfen</a>
      <span class="placeholder-tag mt-5 self-start">Platzhalter</span>
    </article>
  ))}
</div>
