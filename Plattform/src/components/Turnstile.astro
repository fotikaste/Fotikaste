---
/** Cloudflare Turnstile (gratis, Schutz gegen Bots). Nur aktiv, wenn PUBLIC_TURNSTILE_SITE_KEY beim Build gesetzt ist. */
const key = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---
{key && (
  <>
    <div class="cf-turnstile mt-4" data-sitekey={key} data-language="de"></div>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </>
)}
