---
import ContentLayout from "../layouts/ContentLayout.astro";
---
<ContentLayout path="/verfuegbarkeit" eyebrow="Verfügbarkeit" heading="Wunschtermin prüfen" lead="Hier entsteht in Phase 3 der Verfügbarkeitskalender mit Direktbuchung.">
  <div class="border border-dashed border-gold bg-white p-8 max-w-2xl">
    <p class="placeholder-tag">Buchung ab Phase 3</p>
    <p class="mt-4 text-muted">Der Kalender prüft dann in Echtzeit, ob eine Fotobox und die Lieferung an Ihrem Datum frei sind, und hält den Termin während der Buchung 15 Minuten für Sie frei.</p>
  </div>
</ContentLayout>
