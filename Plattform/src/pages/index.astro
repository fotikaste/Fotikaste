---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostcardStack from "../components/PostcardStack.astro";
import PackageCards from "../components/PackageCards.astro";
import FaqList from "../components/FaqList.astro";
import { benefits, steps, occasions, faqs, productFacts } from "../data/content";
import { serviceJsonLd, faqJsonLd } from "../lib/seo";
import { brand } from "../config/brand";
import Picture from "../components/Picture.astro";
import { images, occasionImages } from "../data/images";
const homeFaqs = faqs.slice(0, 5);
---
<BaseLayout path="/" jsonLd={[serviceJsonLd(), faqJsonLd(homeFaqs)]}>
  <!-- 1 Hero -->
  <section class="bg-paper border-b border-line">
    <div class="container-page grid lg:grid-cols-[1.05fr_.95fr] gap-12 lg:gap-16 items-center py-14 sm:py-20 lg:py-24">
      <div class="order-2 lg:order-1">
        <p class="eyebrow">Fotobox mieten · Ostschweiz &amp; Zürich</p>
        <h1 class="text-[2.9rem] sm:text-6xl lg:text-[4.6rem] mt-5">Besondere Momente. <em class="text-gold-text">Bleibende</em> Erinnerungen.</h1>
        <p class="mt-6 text-lg text-muted max-w-[42ch]">Die Fotobox für Hochzeiten, besondere Feiern und Firmenanlässe. Jeder Gast hält sein Foto nach wenigen Sekunden als Postkarte in der Hand – und auf Wunsch auch auf dem Handy.</p>
        <form action="/verfuegbarkeit" method="get" class="mt-9 flex flex-col sm:flex-row max-w-lg border border-charcoal bg-white">
          <label for="datum" class="sr-only">Eventdatum</label>
          <input id="datum" name="datum" type="date" class="flex-1 min-h-12 px-4 py-3 bg-transparent text-charcoal" />
          <button type="submit" class="btn btn-primary">Verfügbarkeit prüfen</button>
        </form>
        <p class="mt-3 text-sm text-muted">Direkt online buchen, Bestätigung sofort per E-Mail. <span class="placeholder-tag ml-1">Buchung ab Phase 3</span></p>
      </div>
      <div class="order-1 lg:order-2 fade-in-delay"><PostcardStack priority /></div>
    </div>
  </section>

  <!-- 2 Erlebnis -->
  <section class="container-page py-20 sm:py-28 grid lg:grid-cols-[.8fr_1.2fr] gap-10 lg:gap-20">
    <div><p class="eyebrow">Das Erlebnis</p><div class="rule-gold mt-5"></div></div>
    <div>
      <h2 class="text-4xl sm:text-5xl">Ein Moment, den man mitnehmen kann.</h2>
      <p class="mt-6 text-lg text-muted max-w-[60ch]">Gäste tippen auf den Bildschirm, sehen sich im Livebild und lächeln in den Countdown. Die Spiegelreflexkamera löst aus, und Sekunden später liegt die Postkarte im Format 10 × 15 cm bereit. Ohne Anleitung, ohne Wartezeit, ohne Gedränge am Handy.</p>
      <p class="mt-4 text-lg text-muted max-w-[60ch]">{brand.name} ist eine eigene Entwicklung aus der Ostschweiz: Hardware, Software und Galerie stammen aus einer Hand.</p>
      <figure class="mt-10 m-0">
        <Picture image={images.abzuegeLeinen} sizes="(min-width: 1024px) 700px, 100vw" class="w-full h-auto" />
        <figcaption class="mt-2 text-xs text-muted">Symbolbild (KI-generiert)</figcaption>
      </figure>
    </div>
  </section>

  <!-- 3 Vorteile -->
  <section class="bg-white border-y border-line">
    <div class="container-page py-20 sm:py-24">
      <h2 class="text-4xl sm:text-5xl max-w-[18ch]">Warum {brand.name}</h2>
      <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((b) => (
          <div class="border-t border-charcoal pt-5"><h3 class="text-2xl">{b.title}</h3><p class="mt-3 text-muted">{b.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Ablauf -->
  <section class="container-page py-20 sm:py-28">
    <p class="eyebrow">So funktioniert die Miete</p>
    <h2 class="text-4xl sm:text-5xl mt-4">In vier Schritten zur Fotobox</h2>
    <ol class="mt-12 grid gap-8 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="flex flex-col gap-3"><span class="font-display text-5xl text-gold leading-none">{i + 1}</span><h3 class="text-2xl">{s.title}</h3><p class="text-muted">{s.text}</p></li>
      ))}
    </ol>
  </section>

  <!-- 5 Angebote -->
  <section class="bg-paper border-y border-line" id="pakete">
    <div class="container-page py-20 sm:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div><p class="eyebrow">Angebote</p><h2 class="text-4xl sm:text-5xl mt-4">Pakete</h2><p class="mt-4 text-muted max-w-[55ch]">Alle Leistungen und Preise transparent, Lieferkosten nach Entfernung vor der Buchung sichtbar. Preise werden derzeit festgelegt.</p></div>
        <a href="/preise" class="btn btn-outline">Alle Leistungen vergleichen</a>
      </div>
      <PackageCards />
    </div>
  </section>

  <!-- Produkt (Kurzfakten) -->
  <section class="container-page py-20 sm:py-28 grid lg:grid-cols-2 gap-12 items-start">
    <div>
      <p class="eyebrow">Unsere Fotobox</p>
      <h2 class="text-4xl sm:text-5xl mt-4">Technik, die man nicht bemerkt</h2>
      <p class="mt-5 text-muted max-w-[52ch]">Profitechnik im Inneren, schlichte Bedienung aussen. Noch nicht vermessene Angaben ergänzen wir, sobald die finale Fotobox fertig ist.</p>
      <a href="/fotobox" class="btn btn-outline mt-8">Zur Fotobox</a>
    </div>
    <dl class="border-t border-line">
      {productFacts.map((f) => (
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-4 border-b border-line"><dt class="text-muted">{f.label}</dt><dd>{f.value ?? <span class="text-muted italic">Angabe folgt</span>}</dd></div>
      ))}
    </dl>
  </section>

  <!-- 6 Anlässe -->
  <section class="bg-white border-y border-line">
    <div class="container-page py-20 sm:py-24">
      <h2 class="text-4xl sm:text-5xl">Für jeden Anlass</h2>
      <p class="mt-3 text-xs text-muted">Symbolbilder (KI-generiert)</p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {occasions.map((o) => (
          <a href={o.href} class="group border border-line bg-white flex flex-col hover:border-charcoal transition-colors">
            <div class="overflow-hidden aspect-[3/2]"><Picture image={occasionImages[o.href as keyof typeof occasionImages]} sizes="(min-width: 768px) 380px, 100vw" class="w-full h-full object-cover object-[50%_35%] transition-transform duration-700 group-hover:scale-[1.03]" /></div>
            <div class="p-7 flex flex-col gap-3 flex-1">
            <h3 class="text-3xl">{o.title}</h3><p class="text-muted flex-1">{o.text}</p><span class="font-semibold link-underline self-start group-hover:text-gold-text">Mehr erfahren</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 Beispielgalerie -->
  <section class="container-page py-20 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6"><h2 class="text-4xl sm:text-5xl">Beispielgalerie</h2><span class="placeholder-tag">Echte Fotos folgen nach den ersten Events</span></div>
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => <div class:list={["aspect-[2/3] bg-white p-2 pb-8 shadow-[0_14px_30px_-22px_rgba(40,30,10,.5)]", i % 2 ? "rotate-1" : "-rotate-1"]}><div class="h-full bg-sand-light"></div></div>)}
    </div>
  </section>

  <!-- 8 Bewertungen (leerer Zustand, keine erfundenen Bewertungen) -->
  <section class="bg-paper border-y border-line">
    <div class="container-page py-16 text-center">
      <h2 class="text-3xl sm:text-4xl">Stimmen unserer Kundinnen und Kunden</h2>
      <p class="mt-4 text-muted max-w-[52ch] mx-auto">Hier erscheinen echte Bewertungen, sobald die ersten Events stattgefunden haben. Wir zeigen keine gekauften oder erfundenen Bewertungen.</p>
    </div>
  </section>

  <!-- 9 FAQ -->
  <section class="container-page py-20 sm:py-28 grid lg:grid-cols-[.8fr_1.2fr] gap-10 lg:gap-20">
    <div><p class="eyebrow">Häufige Fragen</p><h2 class="text-4xl sm:text-5xl mt-4">Gut zu wissen</h2><a href="/faq" class="inline-block mt-6 font-semibold link-underline">Alle Fragen</a></div>
    <FaqList items={homeFaqs} />
  </section>

  <!-- 10 Buchungsaufforderung -->
  <section class="container-page">
    <div class="bg-charcoal text-white px-6 py-16 sm:px-16 sm:py-20 grid lg:grid-cols-[1fr_auto] gap-8 items-center">
      <div><h2 class="text-4xl sm:text-5xl">Ist Ihr Wunschtermin noch frei?</h2><p class="mt-4 text-[#D9D2C6] max-w-[50ch]">Prüfen Sie die Verfügbarkeit in wenigen Sekunden und buchen Sie direkt online.</p></div>
      <a href="/verfuegbarkeit" class="btn bg-[#CDB284] text-charcoal hover:bg-white">Verfügbarkeit prüfen</a>
    </div>
  </section>
</BaseLayout>
